{
  "name": "hukou_register",
  "display_name": "常住人口登记表",
  "fields": [
    {"name": "姓名", "default": "X", "description": "人员姓名"},
    {"name": "曾用名", "default": "", "description": "曾用名或别名"},
    {"name": "性别", "default": "X", "description": "性别"},
    {"name": "民族", "default": "X", "description": "民族"},
    {"name": "出生日期", "default": "X", "description": "出生日期"},
    {"name": "与户主关系", "default": "X", "description": "与户主关系"},
    {"name": "籍贯", "default": "X", "description": "籍贯"},
    {"name": "文化程度", "default": "X", "description": "文化程度"},
    {"name": "工作单位", "default": "X", "description": "工作单位"},
    {"name": "婚姻状况", "default": "X", "description": "婚姻状况"},
    {"name": "户别", "default": "X", "description": "户别"},
    {"name": "登记日期", "default": "X", "description": "登记日期"},
    {"name": "现住址", "default": "X", "description": "现住址"},
    {"name": "签发日期", "default": "X", "description": "签发日期"},
    {"name": "居民证编号", "default": "X", "description": "居民证编号"}
  ],
  "prompt": {
    "document_type": "常住人口登记表",
    "rules": [
      "严格按照OCR结果从左到右、从上到下的顺序理解内容。",
      "仅提取OCR文本中明确存在的信息，不得自行添加、修改或猜测。",
      "如果同类字段有多个值，按OCR出现顺序依次分配给对应记录。",
      "整户共用信息可以分配给所有记录。",
      "输出必须是JSON数组，数组中的每个元素代表一条记录。"
    ]
  },
  "fallback_record": {
    "姓名": "X",
    "曾用名": "",
    "性别": "X",
    "民族": "X",
    "出生日期": "X",
    "与户主关系": "X",
    "籍贯": "X",
    "文化程度": "X",
    "工作单位": "X",
    "婚姻状况": "X",
    "户别": "X",
    "登记日期": "X",
    "现住址": "X",
    "签发日期": "X",
    "居民证编号": "X"
  },
  "output": {
    "sheet_name": "Sheet",
    "text_columns": ["出生日期", "登记日期"],
    "first_row_overrides": {
      "与户主关系": "户主"
    },
    "columns": [
      {"header": "档号", "source": "constant", "value": ""},
      {"header": "全宗号", "source": "constant", "value": ""},
      {"header": "类别号", "source": "constant", "value": ""},
      {"header": "属类号", "source": "constant", "value": ""},
      {"header": "目录号", "source": "constant", "value": ""},
      {"header": "案卷号", "source": "image_parent_name"},
      {"header": "件号", "source": "constant", "value": ""},
      {"header": "人物卡号", "source": "constant", "value": ""},
      {"header": "归档部门", "source": "constant", "value": ""},
      {"header": "年度", "source": "constant", "value": ""},
      {"header": "姓名", "source": "field", "field": "姓名"},
      {"header": "曾用名", "source": "field", "field": "曾用名"},
      {"header": "性别", "source": "field", "field": "性别"},
      {"header": "民族", "source": "field", "field": "民族"},
      {"header": "出生日期", "source": "field", "field": "出生日期"},
      {"header": "证件号码", "source": "field", "field": "居民证编号"},
      {"header": "证件类型", "source": "constant", "value": ""},
      {"header": "与户主关系", "source": "field", "field": "与户主关系"},
      {"header": "籍贯", "source": "field", "field": "籍贯"},
      {"header": "保管期限", "source": "constant", "value": ""},
      {"header": "国籍", "source": "constant", "value": ""},
      {"header": "文化程度", "source": "field", "field": "文化程度"},
      {"header": "户籍地", "source": "constant", "value": ""},
      {"header": "现住址", "source": "field", "field": "现住址"},
      {"header": "工作单位", "source": "field", "field": "工作单位"},
      {"header": "人员状态", "source": "constant", "value": ""},
      {"header": "与申请人关系", "source": "constant", "value": ""},
      {"header": "婚姻状况", "source": "field", "field": "婚姻状况"},
      {"header": "户号", "source": "constant", "value": ""},
      {"header": "户别", "source": "field", "field": "户别"},
      {"header": "公民出生证签发日期", "source": "constant", "value": ""},
      {"header": "本市其他住址", "source": "constant", "value": ""},
      {"header": "宗教信仰", "source": "constant", "value": ""},
      {"header": "居民身份证签发日期", "source": "field", "field": "签发日期"},
      {"header": "何时何因由何地迁来本市", "source": "constant", "value": ""},
      {"header": "何时何因由何地迁来本址", "source": "constant", "value": ""},
      {"header": "何时何因迁往何地", "source": "constant", "value": ""},
      {"header": "何时何因注销户口", "source": "constant", "value": ""},
      {"header": "登记机关", "source": "constant", "value": ""},
      {"header": "登记日期", "source": "field", "field": "登记日期"},
      {"header": "原始图片名称", "source": "image_name"}
    ]
  }
}
